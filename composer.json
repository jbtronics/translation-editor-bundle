{
  "name": "jbtronics/translation-editor-bundle",
  "type": "symfony-bundle",
  "license": "MIT",
  "description": "A symfony bundle to allow editing translations in the symfony profiler",
  "keywords": ["translations", "profiler", "symfony", "symfony-bundle"],
  "autoload": {
    "psr-4": {
      "Jbtronics\\TranslationEditorBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jbtronics\\TranslationEditorBundle\\Tests\\TestApplication\\": "tests/TestApplication/src/",
      "Jbtronics\\TranslationEditorBundle\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jan Böhmer",
      "email": "mail@jan-boehmer.de"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/translation-contracts": "^2.5|^3.0",
    "symfony/translation": "^7.0|^6.4|^8.0",
    "symfony/deprecation-contracts": "^3.4",
    "symfony/web-profiler-bundle": "^7.0|^6.4|^8.0",
    "symfony/twig-bundle": "^7.0|^6.4|^8.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpstan/phpstan": "^2.2",
    "ekino/phpstan-banned-code": "^v3.2.0",
    "phpstan/phpstan-strict-rules": "^2.0.0",
    "phpstan/extension-installer": "^1.4.3",
    "symfony/console": "^6.4|^7.0|^8.0",
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "symfony/console": "To use the jbtronics:translation-editor:update-message-ids console command"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
